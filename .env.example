# =============================================================================
# App (scripts/generate-index.ts — npm run generate / dev / build)
# =============================================================================
# 未設定時は下記が既定として使われます。
# Node は .env を自動読み込みしないため、使うときは export か direnv、または:
#   set -a && source .env && set +a && npm run build

METADATA_CACHE_TTL_HOURS=24
METADATA_CACHE_PATH=.cache/metadata-cache.json

# =============================================================================
# Terraform
# =============================================================================
# 設定値は terraform/bootstrap/terraform.tfvars と terraform/app/terraform.tfvars にある（秘密は含まない）。
# bootstrap をローカルで apply するときだけ、次をシェルで export する:
#   GITHUB_TOKEN=$(gh auth token)
#   CLOUDFLARE_API_TOKEN=...   # enable_cloudflare = true のときだけ
# 手順は README の Setup を参照。
